PORT=3001
NODE_ENV=development
# En dev, le code OTP est renvoyé dans la réponse API et affiché dans la console.
# En production : mettre OTP_MODE=provider et brancher server/notify.js sur WhatsApp/SMS.
OTP_MODE=console
# Facultatif : sinon un secret est généré dans data/.secret
JWT_SECRET=
# Derrière un reverse proxy (nginx, Caddy…) pour lire la vraie IP
TRUST_PROXY=0

# Base de données Neon (PostgreSQL)
# Format : postgresql://[user]:[password]@[endpoint].neon.tech/[dbname]?sslmode=require
DATABASE_URL=
